# Line endings are a property of this repository, not of each contributor's
# git config. The harness hashes generated files to decide whether two runs are
# comparable, so a CRLF committed from Windows must not read as a different
# dataset in CI on Linux.
* text=auto eol=lf

# Golden datasets are compared byte-for-byte; never let git touch them.
*.jsonl text eol=lf

# Rendered goldens, compared byte-for-byte against what the tool prints.
tests/snapshots/*.txt text eol=lf

# Published teardown artifacts, diffed against a fresh run by
# `scripts/teardown.py --check`, which CI runs on Windows and Linux.
teardown/artifacts/* text eol=lf
